<!-- Note: This would be a PNG file in production. Creating SVG placeholder for now -->
<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1200" height="630" fill="#1EB5A9"/>

  <!-- Logo -->
  <circle cx="150" cy="315" r="60" fill="#FFD95E" stroke="#2E2D2F" stroke-width="4"/>
  <text x="150" y="335" text-anchor="middle" font-size="48" font-weight="bold" fill="#2E2D2F" font-family="sans-serif">C</text>

  <!-- Main text -->
  <text x="250" y="300" font-size="72" font-weight="bold" fill="#FFFFFF" font-family="sans-serif">Commishly</text>
  <text x="250" y="370" font-size="36" fill="#FFD95E" font-family="sans-serif">Broker commissions, made clear.</text>

  <!-- Decorative elements -->
  <circle cx="1050" cy="150" r="40" fill="#B9F6CA" opacity="0.4"/>
  <circle cx="980" cy="500" r="50" fill="#C5A3FF" opacity="0.3"/>
  <circle cx="1100" cy="400" r="30" fill="#FF7A64" opacity="0.4"/>
</svg>
